<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaomi.settings"
    android:versionCode="2"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BACKUP" />
    <uses-permission android:name="android.permission.REBOOT" />

    <application
        android:label="@string/device_settings_app_name"
        android:persistent="true"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".display.ColorModeService"
            android:permission="ColorModeService">
        </service>

        <service
            android:name=".display.DozeBrightnessService"
            android:permission="DozeBrightnessService">
        </service>

        <service
            android:name=".display.DcDimmingTileService"
            android:exported="true"
            android:icon="@drawable/ic_dc_dimming"
            android:label="@string/dc_dimming_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".touch.HighTouchPollingService"
            android:permission="HighTouchPollingService">
        </service>

        <service
            android:name=".touch.HighTouchPollingTileService"
            android:exported="true"
            android:icon="@drawable/ic_touch_polling"
            android:label="@string/high_touch_polling_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <activity
            android:name=".backup.SeedvaultLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher_seedvault"
            android:label="@string/seedvault_launcher_title"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Also listed in Settings › System, with the last backup as summary -->
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/seedvault_launcher_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://com.xiaomi.settings.seedvault_status/getSummary" />
        </activity>

        <receiver
            android:name=".backup.SeedvaultStatus$Receiver"
            android:exported="true"
            android:permission="android.permission.BACKUP">
            <intent-filter>
                <action android:name="com.xiaomi.settings.action.SEEDVAULT_BACKUP_RESULT" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".backup.SeedvaultStatus$Provider"
            android:authorities="com.xiaomi.settings.seedvault_status"
            android:exported="true"
            android:readPermission="android.permission.WRITE_SECURE_SETTINGS" />

        <service
            android:name=".backup.TransportRestoreJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".battery.BatteryHealthActivity"
            android:exported="true"
            android:label="@string/battery_health_title"
            android:theme="@*android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/battery_health_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/battery_health_summary" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-100" />
        </activity>

        <service
            android:name=".battery.ChargingControlTileService"
            android:exported="true"
            android:icon="@drawable/ic_charging_control"
            android:label="@string/charging_control_tile_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <activity
            android:name=".security.AutoRebootActivity"
            android:exported="true"
            android:label="@string/auto_reboot_title"
            android:theme="@*android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/auto_reboot_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/auto_reboot_summary" />
        </activity>

        <receiver
            android:name=".security.AutoRebootReceiver"
            android:exported="false" />

    </application>
</manifest>
