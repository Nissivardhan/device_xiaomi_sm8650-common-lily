    <!-- Auto restart when locked (Settings › System) -->
    <string name="auto_reboot_title">Auto restart when locked</string>
    <string name="auto_reboot_summary">Restart the phone after it stays locked for a while</string>
    <string name="auto_reboot_note">After a restart your data stays encrypted until you enter your PIN, pattern or password. The countdown starts when the screen turns off and resets every time you unlock. It waits while you\'re in a call.</string>
