# Binder
binder_call(system_app, hal_audio_default)
binder_call(system_app, hal_bootctl_default)
binder_call(system_app, hal_camera_default)
binder_call(system_app, hal_contexthub_default)
binder_call(system_app, hal_fingerprint_default)
binder_call(system_app, hal_health_default)
binder_call(system_app, hal_ir_default)
binder_call(system_app, hal_memtrack_default)
binder_call(system_app, hal_nfc_default)
binder_call(system_app, hal_power_default)
binder_call(system_app, hal_secure_element_default)
binder_call(system_app, hal_touchfeature_xiaomi_default)
binder_call(system_app, vendor_hal_gatekeeper_qti)
binder_call(system_app, vendor_hal_gnss_qti)
binder_call(system_app, vendor_hal_keymint_qti)
binder_call(system_app, vendor_hal_displayfeature_xiaomi_default)

# Turbo Charging (XiaomiTurboCharging app)
allow system_app vendor_sysfs_battery_supply:dir search;
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;
allow system_app self:netlink_kobject_uevent_socket { create read bind getopt setopt };

# Thermal
get_prop(system_app, vendor_thermal_normal_prop)

# AOD brightness (XiaomiParts DozeBrightnessService)
allow system_app vendor_sysfs_displayfeature:dir search;
allow system_app vendor_sysfs_displayfeature:file rw_file_perms;
allow system_app vendor_sysfs_graphics:dir search;
allow system_app vendor_sysfs_graphics:file rw_file_perms;
