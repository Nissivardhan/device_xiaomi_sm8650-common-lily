Patches for the vendor blob repo that this tree expects.
Apply from the ROM source root:

    git -C vendor/xiaomi/sm8650-common apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/sm8650-common-hals-conf.patch

    # displayfeature.default.so -> libtinyxml2_1.so (fixes displayfeature crash), apply in order:
    git -C vendor/xiaomi/sm8650-common apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/sm8650-common-displayfeature-tinyxml2-1-blob.patch
    git -C vendor/xiaomi/sm8650-common apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/sm8650-common-displayfeature-tinyxml2-2-bp.patch

    # drop the "haptics output" mix port from both audio policy configs, so incoming calls
    # ring and vibrate while a Bluetooth headset is connected:
    git -C vendor/xiaomi/sm8650-common apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/sm8650-common-audio-no-haptics.patch

    # Dolby blobs: depend only on libstagefright_foundation-v33 (mixing it with the
    # platform libstagefright_foundation crashed the audio HAL in libhwdap):
    git -C vendor/xiaomi/sm8650-common apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/sm8650-common-dolby-foundation-v33.patch

    # External Dolby (hardware/dolby from Tsaritsa-Prjkt, lineage-24.0): drop the Xiaomi Dolby
    # modules it replaces and switch the effects to the software DAP. Needs hardware/dolby:
    #   git clone -b lineage-24.0 https://github.com/Tsaritsa-Prjkt/android_hardware_dolby hardware/dolby
    git -C vendor/xiaomi/sm8650-common apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/sm8650-common-dolby-external.patch

    # hardware/dolby: rename its preinstalled-packages module, PixelOS packages/apps/DolbyAtmos
    # defines the same name:
    git -C hardware/dolby apply $(pwd)/device/xiaomi/sm8650-common/vendor-patches/hardware-dolby-preinstalled-rename.patch
