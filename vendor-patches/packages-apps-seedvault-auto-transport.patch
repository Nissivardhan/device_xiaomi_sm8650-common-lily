--- /dev/null
+++ b/app/src/main/java/com/stevesoltys/seedvault/transport/TransportSwitcher.kt
@@ -0,0 +1,65 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Nissi Builds
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.stevesoltys.seedvault.transport
+
+import android.app.backup.IBackupManager
+import android.content.Context
+import android.os.UserHandle
+import android.util.Log
+
+private const val TAG = "TransportSwitcher"
+private const val PREFS = "transport_switcher"
+private const val KEY_PREVIOUS = "previous_transport"
+
+/**
+ * Lets Seedvault's scheduled backup run while another backup service (Google) stays the
+ * active one: switch to Seedvault for the app data backup, then put the previous one back.
+ */
+object TransportSwitcher {
+
+    /** Makes Seedvault the active transport, remembering the current one. */
+    fun switchToSeedvault(context: Context, backupManager: IBackupManager): Boolean {
+        val current = try {
+            backupManager.currentTransport
+        } catch (e: Exception) {
+            Log.e(TAG, "Couldn't read the current transport", e)
+            return false
+        }
+        if (current == null || current == TRANSPORT_ID) return true
+        return try {
+            prefs(context).edit().putString(KEY_PREVIOUS, current).commit()
+            @Suppress("DEPRECATION")
+            backupManager.selectBackupTransport(TRANSPORT_ID)
+            Log.i(TAG, "Switched from $current to Seedvault for this backup")
+            backupManager.currentTransport == TRANSPORT_ID
+        } catch (e: Exception) {
+            Log.e(TAG, "Couldn't switch to Seedvault", e)
+            false
+        }
+    }
+
+    /** Puts back the transport saved by [switchToSeedvault], if any. */
+    fun restore(context: Context, backupManager: IBackupManager) {
+        val previous = prefs(context).getString(KEY_PREVIOUS, null) ?: return
+        try {
+            // respect a manual change made while the backup was running
+            if (backupManager.currentTransport == TRANSPORT_ID) {
+                @Suppress("DEPRECATION")
+                backupManager.selectBackupTransport(previous)
+            }
+            // the other service relies on the framework's own daily backup jobs
+            backupManager.setFrameworkSchedulingEnabledForUser(UserHandle.myUserId(), true)
+            Log.i(TAG, "Switched back to $previous")
+        } catch (e: Exception) {
+            Log.e(TAG, "Couldn't switch back to $previous", e)
+        } finally {
+            prefs(context).edit().remove(KEY_PREVIOUS).commit()
+        }
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+}
