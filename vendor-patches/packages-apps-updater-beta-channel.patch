+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package net.pixelos.ota.data
+
+import android.content.Context
+import android.provider.Settings
+import java.security.MessageDigest
+
+/**
+ * Invite-only beta channel. Every phone has a beta tester ID derived from its Android ID
+ * (not reversible). A phone gets beta builds only if the feed repo has a file for its ID,
+ * next to the stable feed: .../updater/beta/<id>.json. Everyone else reads the stable feed.
+ * The ID changes after a factory reset.
+ */
+object BetaChannel {
+
+    fun testerId(context: Context): String {
+        val androidId = Settings.Secure.getString(
+            context.contentResolver, Settings.Secure.ANDROID_ID
+        ).orEmpty()
+        val digest = MessageDigest.getInstance("SHA-256")
+            .digest("houji-ota-beta:$androidId".toByteArray())
+        return digest.take(6).joinToString("") { "%02x".format(it) }
+    }
+
+    fun feedUrl(stableUrl: String, testerId: String): String =
+        stableUrl.substringBeforeLast('/') + "/beta/" + testerId + ".json"
+}
